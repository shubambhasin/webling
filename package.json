{
  "name": "webling",
  "version": "0.1.0",
  "private": true,
  "description": "A tiny pixel pet that lives on the internet.",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build:site": "node scripts/build-site.mjs",
    "server": "npm --prefix server start",
    "icons": "node scripts/make-icons.mjs",
    "zip": "node scripts/zip.mjs",
    "store": "node scripts/store-assets.mjs",
    "test": "node --test --test-concurrency=1 'test/*.test.mjs' && npm --prefix server test",
    "test:unit": "node --test 'test/shared.test.mjs' 'test/voice.test.mjs' 'test/background.test.mjs' 'test/store.test.mjs' && npm --prefix server test",
    "test:e2e": "node --test --test-concurrency=1 'test/*.e2e.test.mjs'"
  },
  "license": "MIT"
}
